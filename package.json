{
    "name": "eejitstools",
    "type": "module",
    "scripts": {
        "build": "pnpm run remove-compiled && npx esbuild compile.ts --outfile=compile.js --target=node20 --platform=node && node compile.js",
        "dev": "pnpm run build && node --env-file=.env development.js --enable-source-maps",
        "remove-compiled": "rm -rf dist && find . -maxdepth 1 -type f \\( -name '*.js' -o -name '*.js.map' \\) ! -name 'eslint.config.js' -delete",
        "start": "node --no-warnings --enable-source-maps --max-old-space-size=100 dist/app.js"
    },
    "prettier": "@eejit/prettier-config",
    "dependencies": {
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/static": "^10.1.5",
        "@fastify/view": "^12.0.0",
        "canvas": "^3.2.3",
        "chalk": "^6.0.1",
        "chokidar": "^5.0.0",
        "consola": "^3.4.2",
        "esbuild": "^0.28.2",
        "esbuild-postcss": "^0.0.4",
        "fastify": "^5.8.4",
        "handlebars": "^4.7.10",
        "mongoose": "^9.11.0",
        "node-html-parser": "^9.0.4",
        "postcss-preset-env": "^11.6.1"
    },
    "devDependencies": {
        "@dword-design/eslint-plugin-import-alias": "^8.1.8",
        "@eejit/eslint-config-typescript": "^20.5.1",
        "@eejit/prettier-config": "^3.7.0",
        "@eejit/stylelint-config": "^6.0.0",
        "@types/chroma-js": "^3.1.2",
        "@types/ua-parser-js": "^0.7.39",
        "mathjs": "^15.1.1",
        "postcss": "^8.5.29",
        "stylelint": "^17.16.0",
        "tree-kill": "^1.2.2",
        "tsc-alias": "^1.9.7",
        "typescript": "^6.0.2"
    },
    "packageManager": "pnpm@11.5.1"
}
